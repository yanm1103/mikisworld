<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MikisWorldCollection</AssemblyName>
    <Version>1.1.0</Version>
    <ApplicationIcon>game.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\collectionlogo.png" LogicalName="collectionlogo.png" />
    <EmbeddedResource Include="..\splash.png" LogicalName="splash.png" />
    <EmbeddedResource Include="Shaders\*.glsl" LogicalName="shader-%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="6.1.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MikisWorld.Core\MikisWorld.Core.csproj" />
  </ItemGroup>
</Project>
